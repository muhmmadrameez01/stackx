datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  summary         String    @db.Text
  content         String    @db.Text
  coverImage      String?
  published       Boolean   @default(true)
  scheduledAt     DateTime?
  status          String    @default("published")
  featured        Boolean   @default(false)
  views           Int       @default(0)
  readingTime     Int       @default(3)
  metaTitle       String?
  metaDescription String?   @db.Text
  keywords        String?   @db.Text
  canonicalUrl    String?
  schemaType      String    @default("BlogPosting")
  authorName      String    @default("Stackx Team")
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([slug])
  @@index([published])
  @@index([categoryId])
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  posts       BlogPost[]
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique
}

model AdMetric {
  id          String   @id @default(cuid())
  date        String   // "YYYY-MM-DD"
  placement   String   // "headerBanner", "toolResultBanner", "toolBottomBanner", "blogSidebarBanner", "autoAds"
  impressions Int      @default(0)
  clicks      Int      @default(0)
  revenue     Float    @default(0.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, placement])
  @@index([date])
}
